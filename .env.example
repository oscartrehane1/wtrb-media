# Resend (required for enquiry delivery)
RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=hello@wtrbmedia.co.uk
CONTACT_FROM_EMAIL=website@wtrbmedia.co.uk

# Serverless rate limiting (recommended in addition to Vercel Firewall rules)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token
RATE_LIMIT_SALT=replace-with-a-long-random-server-only-value

# Public Vercel Blob: connect wtrb-media-blob to wtrb-media in Vercel.
# Recommended: Vercel supplies BLOB_STORE_ID and rotates VERCEL_OIDC_TOKEN.
# Do not manually copy an OIDC token. For local use: vercel env pull .env.local
# Optional legacy alternative only (not required with the managed OIDC connection):
BLOB_READ_WRITE_TOKEN=
